# 开发期手工抓取的真实配置样本与抓取记录：含外部 TVBox 配置地址，禁止入库
tests/fixtures/manual/
docs/verification-config.md

# 上游源码镜像与工具临时目录（只读参考，不作为本仓库内容）
.workbuddy/upstream/

# 联调产物：UI 截图、临时日志与一次性诊断脚本（.workbuddy/memory 仍需入库）
.workbuddy/*.png
.workbuddy/*.txt
.workbuddy/q_*
.workbuddy/probe_*
.workbuddy/*.json
# 便携版/安装包的本机解压验证目录
.workbuddy/*-test/
.workbuddy/user-config.b64

# ---- 编译产物（三类，各自唯一位置，均可重建）----
# ① 前端：Vite 产出，tauri.conf.json 的 frontendDist 指向 ../dist
dist/
# ② Rust：Cargo 在每个 crate 根下产出 target/，含 debug/ release/ bundle/
#    注意：根 target/ 不会出现（非 workspace），无需忽略。
src-tauri/target/
src-tauri/gen/
#    qjs-runner 是独立 crate，Cargo 会在自己目录产出 target/（prepare_runtime.py
#    依赖该路径取 qjs-runner.exe，故只是忽略、不挪位置）。将来新增独立 crate 同理。
sidecars/qjs-runner/target/
# ③ 交付包：tools/make_portable.py 组装的便携版目录与 zip（有意偏离标准 bundle/）
release/

# ---- 依赖 / 本地环境 / 缓存 ----
node_modules/
__pycache__/
*.pyc

# SQLite 运行时数据（便携版 data/ 或 dev 回退目录，绝不入库）
/data/
tvbox.db
tvbox.db-wal
tvbox.db-shm
luma.db
luma.db-wal
luma.db-shm

# ---- 随包 JS 依赖资源（入库源码资源，不是运行时产物，必须跟踪）----
# sidecars/qjs-assets/ 下 8 个 JS 依赖与 manifest.json 由上游固定 commit 抓取后
# 直接入库，是客户端 QuickJS ESM 模块加载的交付内容本身。与下面「随包运行时产物」
# 段落刻意区分：那些目录由 tools/prepare_runtime.py 下载/裁剪重建、整目录忽略；
# 这里只由 tools/prepare_runtime.py::step_qjs_assets() 做只读齐全性/SHA256 校验，
# 不下载、不可重建。下面三行把「必须跟踪」显式写进配置（当前并无规则误伤），
# 与产物段落形成对照；若将来新增宽泛规则，请同步在此补否定项。
!sidecars/qjs-assets/
!sidecars/qjs-assets/manifest.json
!sidecars/qjs-assets/js/lib/*.js

# 随包运行时产物（非编译生成：由 tools/prepare_runtime.py 下载/裁剪重建，不入库）
# 整目录忽略，不保留任何 .gitkeep 占位；sidecars/py、sidecars/java、sidecars/qjs-runner
# 是源码（入库），sidecars/qjs-assets 是入库资源（见上一段），与下面三个二进制
# 产物目录区分开。
sidecars/jre/
sidecars/python-embed/
sidecars/mpv/
src-tauri/binaries/
pnpm-debug.log*
*.log
.DS_Store
Thumbs.db
