# 开发期手工抓取的真实配置样本与抓取记录：含外部 TVBox 配置地址，禁止入库
tests/fixtures/manual/
docs/verification-config.md

# 隔离用的 git worktree 与临时目录（junction 复用主树 node_modules / 运行时，不入库）
.agents/

# 窗口探针 / 诊断脚本的截图与临时产物：统一落在 tools/.out/，可随时整目录删除
tools/.out/

# 会话内上传的图片附件缓存（工具生成，非项目内容，不入库）
.qoder-input-images/

# ---- 编译产物（三类，各自唯一位置，均可重建）----
# ① 前端：Vite 产出，tauri.conf.json 的 frontendDist 指向 ../dist
dist/
# tsc 增量构建缓存（`tsc -b` 在仓库根落一份，可重建）
*.tsbuildinfo
# ② Rust：Cargo 在每个 crate 根下产出 target/，含 debug/ release/ bundle/
#    注意：根 target/ 不会出现（非 workspace），无需忽略。
src-tauri/target/
src-tauri/gen/
#    根 target/ 只在 Agent/CI 侧 cargo check/test 时出现（CARGO_TARGET_DIR 指向
#    这里，避开 dev 进程持有的 src-tauri/target 锁），同样是可重建产物。
/target/

#    qjs-runner 是独立 crate，Cargo 会在自己目录产出 target/（prepare_runtime.py
#    依赖该路径取 qjs-runner.exe，故只是忽略、不挪位置）。将来新增独立 crate 同理。
sidecars/qjs-runner/target/
# ③ 交付包：官方 `tauri build` 产出到 src-tauri/target/release/bundle/（已被
#    src-tauri/target/ 规则覆盖）；release/ 为旧便携版历史产物目录，已废弃。
release/

# ---- 依赖 / 本地环境 / 缓存 ----
node_modules/
__pycache__/
*.pyc

# SQLite 运行时数据（便携版 data/ 或 dev 回退目录，绝不入库）
/data/
luma.db
luma.db-wal
luma.db-shm

# ---- 随包 JS 依赖资源（入库源码资源，不是运行时产物，必须跟踪）----
# sidecars/qjs-assets/ 下 8 个 JS 依赖与 manifest.json 由上游固定 commit 抓取后
# 直接入库，是客户端 QuickJS ESM 模块加载的交付内容本身。与下面「随包运行时产物」
# 段落刻意区分：那些目录由 tools/prepare_runtime.py 下载/裁剪重建、整目录忽略；
# 这里只由 tools/prepare_runtime.py::step_qjs_assets() 做只读齐全性/SHA256 校验，
# 不下载、不可重建。下面三行把「必须跟踪」显式写进配置（当前并无规则误伤），
# 与产物段落形成对照；若将来新增宽泛规则，请同步在此补否定项。
!sidecars/qjs-assets/
!sidecars/qjs-assets/manifest.json
!sidecars/qjs-assets/js/lib/*.js

# 随包运行时产物（非编译生成：由 tools/prepare_runtime.py 下载/裁剪重建，不入库）
# 整目录忽略，不保留任何 .gitkeep 占位；sidecars/py、sidecars/qjs-runner
# 是源码（入库），sidecars/qjs-assets 是入库资源（见上一段），与下面两个二进制
# 产物目录区分开。JVM 运行时已移除，不再忽略 sidecars/jre。
sidecars/python-embed/
sidecars/mpv/
src-tauri/binaries/
pnpm-debug.log*
*.log
.DS_Store
Thumbs.db

# CodeGraph 本地索引：`.codegraph/`（SQLite 库 + 日志）由 `codegraph init/index`
# 按当前工作树重建，本机实测 25.7 MB，属可重建产物，绝不入库。
.codegraph/

# WorkBuddy 会话/记忆数据：`.workbuddy/` 由工具本地维护，非项目内容，不入库。
.workbuddy/
