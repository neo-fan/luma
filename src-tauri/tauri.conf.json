{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luma",
  "version": "1.0.2",
  "identifier": "dev.luma.desktop",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Luma",
        "theme": "Dark",
        "backgroundColor": "#0a0a0b",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "additionalBrowserArgs": "--enable-features=PlatformHEVCDecoderSupport --ignore-gpu-blocklist --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "TVBox 配置兼容桌面客户端",
    "longDescription": "Luma 是 TVBox 配置的桌面播放客户端，支持 CMS / Python / JS 源、直播与本地 ArtPlayer 播放。",
    "publisher": "Luma",
    "category": "Utility",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "../sidecars/py": "sidecars/py",
      "../sidecars/python-embed": "sidecars/python-embed",
      "../sidecars/jre": "sidecars/jre",
      "../sidecars/java": "sidecars/java",
      "../sidecars/qjs-assets": "sidecars/qjs-assets"
    },
    "externalBin": [
      "binaries/qjs-runner"
    ]
  }
}
