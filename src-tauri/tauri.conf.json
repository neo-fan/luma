{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luma",
  "version": "1.0.0",
  "identifier": "dev.luma.desktop",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Luma",
        "theme": "Dark",
        "backgroundColor": "#0a0a0b",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "additionalBrowserArgs": "--enable-features=PlatformHEVCDecoderSupport --ignore-gpu-blocklist --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "targets": []
  }
}
