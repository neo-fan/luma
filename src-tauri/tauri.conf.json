{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TVBox Desktop",
  "version": "0.1.0",
  "identifier": "dev.tvbox.desktop",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TVBox Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "additionalBrowserArgs": "--enable-features=PlatformHEVCDecoderSupport --ignore-gpu-blocklist --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/qjs-runner"],
    "resources": {
      "../sidecars/py": "sidecars/py",
      "../sidecars/python-embed": "sidecars/python-embed",
      "../sidecars/java/runner.jar": "sidecars/java/runner.jar",
      "../sidecars/jre": "sidecars/jre"
    }
  }
}
